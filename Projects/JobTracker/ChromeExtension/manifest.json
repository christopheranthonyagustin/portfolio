{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.0",
  "description": "Save jobs from JobStreet",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://careerops-api-372955811478.asia-southeast1.run.app/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}